{
  "name": "pantry-recipe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "data:extract": "python -I scripts/extract_pilot.py",
    "data:validate": "python -I scripts/validate_catalog.py",
    "test": "vitest run",
    "scenario": "vite-node scripts/scenario.ts",
    "data:build": "python -I scripts/build_catalog.py && python -I scripts/validate_catalog.py"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
